APP_NAME="ERM Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# Database Configuration (Host SQLite / Host MySQL)
# ==============================================================================
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Or for local MySQL on host:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=erm_platform
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================================
# ERM Cybersecurity Microservices (Docker Isolated Tools)
# ==============================================================================
# Frida Dynamic Instrumentation Service (Port 8001)
FRIDA_SERVICE_URL=http://127.0.0.1:8001
FRIDA_PORT=8001
FRIDA_TIMEOUT=30
FASTAPI_ENGINE_URL=http://127.0.0.1:8001
FASTAPI_TIMEOUT=300
# Generate an RSA-3072 key pair; keep the private key only on the Laravel host.
ERM_JWT_PRIVATE_KEY_PATH=/etc/erm/keys/jwt-private.pem
ERM_JWT_PUBLIC_KEY_HOST=/etc/erm/keys/jwt-public.pem
ERM_JWT_ISSUER=erm-laravel
ERM_JWT_AUDIENCE=erm-tool-gateway
# Host path mounted read-only into the Frida container (choose the correct Android ABI binary)
FRIDA_SERVER_BINARY_HOST=/absolute/path/to/frida-server-android-arm64
# Explicit ADB targets allowed for remote device connections; empty means deny all.
ADB_ALLOWED_HOSTS=

# MobSF Static/Dynamic Analysis Engine (bound to host loopback only)
MOBSF_PORT=8002
MOBSF_SERVICE_URL=http://127.0.0.1:8002
MOBSF_API_KEY=
MOBSF_TIMEOUT=120

# Objection Mobile Runtime Exploration Service (Port 8003)
OBJECTION_SERVICE_URL=http://127.0.0.1:8003
OBJECTION_PORT=8003
OBJECTION_TIMEOUT=60

# AI Security Analysis Service (Host/External API)
AI_SERVICE_URL=
AI_API_KEY=
AI_PROVIDER=openai


# Startup Options
SEED_DATABASE=true
RUN_MIGRATIONS=true

VITE_APP_NAME="${APP_NAME}"

# JADX APK decompiler (install on the application server)
JADX_BINARY=/usr/local/bin/jadx
JADX_TIMEOUT=900

# Optional bootstrap admin. Leave blank to skip seeding a default account.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@erm.local
DEFAULT_ADMIN_PASSWORD=
