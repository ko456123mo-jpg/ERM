APP_NAME="ERM Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# Database Configuration (Host SQLite / Host MySQL)
# ==============================================================================
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Or for local MySQL on host:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=erm_platform
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================================
# ERM Cybersecurity Microservices (Docker Isolated Tools)
# ==============================================================================
# Frida Dynamic Instrumentation Service (Port 8001)
FRIDA_SERVICE_URL=http://127.0.0.1:8001
FRIDA_PORT=8001
FRIDA_TIMEOUT=30

# MobSF Static/Dynamic Analysis Engine (Port 8002)
MOBSF_SERVICE_URL=http://127.0.0.1:8002
MOBSF_PORT=8002
MOBSF_API_KEY=erm_mobsf_api_key_secure_2026
MOBSF_TIMEOUT=120

# Objection Mobile Runtime Exploration Service (Port 8003)
OBJECTION_SERVICE_URL=http://127.0.0.1:8003
OBJECTION_PORT=8003
OBJECTION_TIMEOUT=60

# AI Security Analysis Service (Host/External API)
AI_SERVICE_URL=
AI_API_KEY=
AI_PROVIDER=openai


# Startup Options
SEED_DATABASE=true
RUN_MIGRATIONS=true

VITE_APP_NAME="${APP_NAME}"

# JADX APK decompiler (install on the application server)
JADX_BINARY=/usr/local/bin/jadx
JADX_TIMEOUT=900
